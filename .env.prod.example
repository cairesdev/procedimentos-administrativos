# Copie para .env.prod NA VPS e preencha. Nenhum destes valores deve voltar
# para o git — o .gitignore já bloqueia .env*.
#
# Uso: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# ---- Domínio e certificado ----------------------------------------------
DOMINIO=procedimentos.suaprefeitura.gov.br
EMAIL_ACME=ti@suaprefeitura.gov.br

# Como o tráfego chega até a VPS. Duas montagens possíveis:
#
# 1) Acesso direto (padrão): registro A apontando para o IP da VPS, portas
#    80/443 abertas. O Caddy emite e renova o certificado sozinho.
#      CADDY_FILE=Caddyfile
#      CADDY_BIND=0.0.0.0
#
# 2) Cloudflare Tunnel: o cloudflared roda na VPS e entrega em http://localhost.
#    Quem serve o HTTPS é a Cloudflare; o Caddy fica em HTTP puro. Sem isto ele
#    redireciona para https:// e o navegador entra em laço de 308.
#    Nesta opção a VPS não precisa de NENHUMA porta aberta na internet.
#      CADDY_FILE=Caddyfile.tunnel
#      CADDY_BIND=127.0.0.1
CADDY_FILE=Caddyfile
CADDY_BIND=0.0.0.0

# ---- Imagem a rodar ------------------------------------------------------
IMAGE_REPO=workcenterma/br-consultoria
# Fixe a versão. `main` também funciona, mas aí você não sabe o que subiu.
IMAGE_TAG=1.0.0

# ---- Identidade do produto ----------------------------------------------
# Só afeta o build da imagem do web, não o runtime. Está aqui como lembrete
# de qual nome foi compilado na tag acima.
APP_NAME=Procedimentos administrativos
APP_SHORT_NAME=Procedimentos

# ---- Segredos ------------------------------------------------------------
# Gere cada um com: openssl rand -base64 32
JWT_SECRET=
AUTH_SECRET=
POSTGRES_USER=procedimentos
POSTGRES_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Primeiro acesso ao painel /admin. Troque a senha depois do primeiro login:
# o container reaplica este valor a cada subida enquanto ele estiver aqui.
ADMIN_NOME=Administrador do sistema
ADMIN_EMAIL=
ADMIN_SENHA=

# ---- Banco ---------------------------------------------------------------
POSTGRES_DB=procedimentos
POSTGRES_SHM=512mb
# true: o deploy aplica as migrations pendentes ao subir a API.
RUN_MIGRATIONS=true

# ---- Anexos --------------------------------------------------------------
# O MinIO não é publicado: o download desce pela própria API.
MINIO_BUCKET=procedimentos
MINIO_REGIAO=us-east-1
# Console só via túnel SSH: ssh -L 9001:localhost:9001 usuario@vps
MINIO_CONSOLE_PORT=9001

# ---- Backup --------------------------------------------------------------
BACKUP_HORA=03
BACKUP_RETENCAO_DIAS=14

# ---- Limites e fuso ------------------------------------------------------
TZ=America/Sao_Paulo
API_MEM=512M
WEB_MEM=512M
