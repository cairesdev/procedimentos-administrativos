DATABASE_URL=postgres://postgres:postgres@localhost:5432/procedimentos
JWT_SECRET=troque-este-segredo
PORT=3333

# Admin master criado por `npm run bootstrap:admin` (opcional em dev).
ADMIN_NOME=Administrador do sistema
ADMIN_EMAIL=admin@local
ADMIN_SENHA=troque-esta-senha

# Anexos. Em bucket gerenciado (domínio + SSL) deixe MINIO_PORT vazio.
MINIO_BUCKET=procedimentos
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGIAO=us-east-1
