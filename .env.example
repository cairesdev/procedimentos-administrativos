# Copie para .env antes de `docker compose up`. As três variáveis sem default
# (JWT_SECRET, AUTH_SECRET, ADMIN_SENHA) fazem o compose falhar se ficarem vazias.

# ---- Identidade do produto ----------------------------------------------
# Entram no bundle do web: mudar exige `docker compose build web`.
APP_NAME=Procedimentos administrativos
APP_SHORT_NAME=Procedimentos

# ---- Imagens -------------------------------------------------------------
IMAGE_REPO=workcenterma/br-consultoria
IMAGE_TAG=local

# ---- Segredos ------------------------------------------------------------
# Gere com: openssl rand -base64 32
JWT_SECRET=
AUTH_SECRET=
ADMIN_NOME=Administrador do sistema
ADMIN_EMAIL=admin@local
ADMIN_SENHA=

# ---- Fuso ----------------------------------------------------------------
TZ=America/Sao_Paulo

# ---- Banco (Postgres 18) -------------------------------------------------
# Dados persistem em ./data/postgres — `docker compose down -v` NÃO apaga.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=procedimentos
POSTGRES_PORT=5432
# true: o container da API aplica as migrations pendentes ao subir.
RUN_MIGRATIONS=true

# ---- Armazenamento de anexos (MinIO) -------------------------------------
# Dados persistem em ./data/minio. Console web em http://localhost:9001.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=procedimentos
MINIO_REGIAO=us-east-1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Portas expostas no host --------------------------------------------
API_PORT=8004
WEB_PORT=3000
AUTH_URL=http://localhost:3000

# --- Envio de e-mail -------------------------------------------------------
# A chave que cifra a senha do SMTP guardada no banco. Gere a sua com:
#   openssl rand -base64 32
# Em produção ela vive só no .env.prod (chmod 600) e NUNCA neste arquivo de
# exemplo — segredo em arquivo de exemplo é segredo queimado, que foi como os
# anteriores se perderam. Perder a chave significa recadastrar as senhas de
# SMTP na tela; não há recuperação.
EMAIL_CHAVE=troque-me-openssl-rand-base64-32

# Endereço público do sistema, usado nos links dentro dos e-mails (convite,
# acompanhamento). Sai daqui e nunca do cabeçalho Host do pedido: o Host vem do
# cliente, e um link de convite apontaria para onde o cliente mandasse.
APP_URL=http://localhost:3000

# Quanto o worker espera entre uma rodada e outra, e quantos e-mails pega por vez.
EMAIL_INTERVALO_MS=60000
EMAIL_LOTE=20
