# Variante para Cloudflare Tunnel (cloudflared).
#
# Aqui quem termina o TLS é a Cloudflare; o túnel entrega em HTTP na origem.
# Por isso o site escuta em `:80` puro: com um nome de domínio no lugar, o
# Caddy ligaria o HTTPS automático e responderia 308 para https://, criando
# laço infinito com o túnel (o clássico "ERR_TOO_MANY_REDIRECTS").
#
# Regra no painel do túnel:  gestaobr.com.br  *  ->  http://localhost

{
	# Sem ACME nesta variante: nenhum certificado é emitido aqui.
	auto_https off

	servers {
		# Quem conecta é o cloudflared, pelo gateway do Docker. Sem isto o log
		# registra 172.18.0.1 para todo visitante.
		trusted_proxies static private_ranges
		client_ip_headers Cf-Connecting-Ip X-Forwarded-For
	}
}

:80 {
	encode zstd gzip

	# Tudo vai para o Next — inclusive /api/*, que aqui é dele (NextAuth em
	# /api/auth e a ponte autenticada em /api/proxy). A API Express NÃO é
	# publicada: só o Next fala com ela, pela rede interna.
	reverse_proxy web:3000

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# HSTS fica a cargo da Cloudflare (SSL/TLS -> Edge Certificates), já que é
	# ela quem serve o HTTPS para o navegador.

	request_body {
		max_size 25MB
	}

	log {
		output stdout
		format json
	}
}
